      { "name": "_type", "type": "string", "default": "domains", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "domains", "dictLabel": "domains" } ], "description": "固定为 domains" },
      { "name": "_action", "type": "string", "default": "import", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "import", "dictLabel": "import" } ], "description": "固定为 import" },
      { "name": "syncFlag", "type": "boolean", "default": true, "htmlType": "boolSelect", "description": "是否同步处理" },
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "语言代码" }
    ]
  },
