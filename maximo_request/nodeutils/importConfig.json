{
  "importMaxObject": {
    "command": "import-object",
    "title": "对象配置导入（新接口）",
    "interface": "SKS_MIGRATEAPI_CONFIGUR",
    "remark": "remarks/importMaxObject.md",
    "params": [
      { "name": "_action", "type": "string", "default": "import", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "import", "dictLabel": "import" } ], "description": "接口功能分发，目前只实现 import" },
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "会话语言代码，脚本会转大写，如 ZH、EN" },
      { "name": "dmDeploySet", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "迁移模式：MboSet 调 setDMDeploySet(true)，并无条件显式设置 MAXTYPE/LENGTH/SCALE（含 0）" },
      { "name": "ignoreAttributes", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "跳过 MAXATTRIBUTECFG 属性处理" },
      { "name": "ignoreRelationships", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "跳过 MAXRELATIONSHIP 关系处理" },
      { "name": "_debug", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "返回 debugMsg 调试信息" }
    ]
  },
  "importMaxObjectV1": {
    "command": "import-object-v1",
    "title": "对象配置导入（旧版接口）",
    "interface": "SKS.AUTOSCRIPT.LIBRARY",
