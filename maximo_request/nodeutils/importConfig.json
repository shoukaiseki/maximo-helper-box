    "params": [
      { "name": "develop", "type": "boolean", "default": true, "htmlType": "boolSelect", "description": "开发模式标记" },
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "语言代码" }
    ]
  },
  "importMaxAppInfoV1": {
    "command": "import-appinfo-v1",
    "title": "应用信息导入（旧版接口）",
    "interface": "SKS_IMP_MAXAPPINFO",
    "remark": "remarks/importMaxAppInfoV1.md",
    "params": [
      { "name": "develop", "type": "boolean", "default": true, "htmlType": "boolSelect", "description": "开发模式标记" },
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "语言代码" }
    ]
  },
  "importMaxAppInfo": {
    "command": "import-appinfo",
    "title": "应用信息导入（新接口）",
    "interface": "SKS.AUTOSCRIPT.SCREENS",
    "remark": "remarks/importMaxAppInfo.md",
    "params": [
      { "name": "_action", "type": "string", "default": "importAppInfo", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "importAppInfo", "dictLabel": "importAppInfo" } ], "description": "固定为 importAppInfo" },
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "语言代码，如 ZH、EN" },
      { "name": "dmDeploySet", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "迁移模式，按目标环境类型重建应用信息" },
      { "name": "_errorAssert", "type": "boolean", "default": false, "htmlType": "boolSelect", "description": "单行失败立即中止整批导入" }
    ]
