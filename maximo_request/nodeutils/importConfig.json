  "callMaxScript": {
    "command": "call",
    "title": "通用脚本调用",
    "interface": "/api/script/<scriptName>",
    "remark": "remarks/callMaxScript.md",
    "params": [
      { "name": "_langcode", "type": "string", "default": "", "htmlType": "select", "htmlTypeOptions": [ { "dictValue": "ZH", "dictLabel": "中文（ZH）" }, { "dictValue": "EN", "dictLabel": "英文（EN）" } ], "description": "语言代码" },
      { "name": "*", "type": "any", "default": "", "description": "其余参数按脚本要求自由传入" }
    ]
  },
  "batchImport": {
    "command": null,
    "title": "批量导入",
    "interface": "本地批量执行",
    "remark": "remarks/batchImport.md",
    "params": [
      { "name": "urlParams", "type": "object", "default": {}, "description": "透传给 importFn 的 URL 参数，最终合并进每个文件的接口请求" },
      { "name": "concurrency", "type": "number", "default": 1, "description": "并发数，默认 1（串行）" }
    ]
  }
